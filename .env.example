# Set this to the hub PC's LAN IPv4 address to view from another device.
DOORCAM_HOST=localhost
DOORCAM_HTTP_PORT=8080
DOORCAM_HTTPS_PORT=8443
# Generate a unique token before starting the workers; see docs/milestones/M5-recording-retention-motion.md.
INTERNAL_WORKER_TOKEN=replace-this-with-a-random-value
RETENTION_DEFAULT_DAYS=7
RETENTION_FREE_PERCENT=10
MOTION_FPS=3
MOTION_THRESHOLD=22
MOTION_MIN_AREA=900
MOTION_COOLDOWN_SECONDS=15
